# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# Telegram bot token from @BotFather. Required for initData validation
# and for the /start "launch app" message.
TELEGRAM_BOT_TOKEN=

# SQLite by default — zero setup, one file. Point this at a Postgres URL
# in production (a managed one, e.g. Railway's Postgres add-on — SQLite
# has no persistent disk on most PaaS hosts, so its file gets wiped on
# every redeploy).
DATABASE_URL=sqlite:///./tarot.db

# API keys for the daily motivating message and the paid AI spread
# interpretation, tried in order: Groq (free — console.groq.com/keys)
# -> Anthropic (pay-as-you-go, tried last). Anthropic is only tried if
# Groq is unset or fails. Both features work with neither configured
# (static fallback content), just less personalized.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# No payment provider is connected, so there is nothing to configure
# here for payments — see DEPLOYMENT.md section 3.2. Subscriptions and
# energy packs cannot be bought at all right now; quota comes only from
# ADMIN_PROMO_CODE below.

# Must match the secret passed to `setWebhook` (see DEPLOYMENT.md) so
# /api/telegram/webhook can reject requests that aren't actually from
# Telegram. Optional locally; required once the bot goes to production.
TELEGRAM_WEBHOOK_SECRET=

# Your deployed Mini App URL (Cloudflare Pages / Vercel domain). Used by
# the /start bot handler to send a "launch app" button as a backup to
# BotFather's chat menu button.
MINI_APP_URL=

# Bot username and Mini App short name from BotFather (no @, no
# slashes — e.g. "mytarolo1gbot" and "mytarolog"). Builds the referral
# link (app/api/referral.py); without these, referral status still
# works but the link itself is null.
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_NAME=

# Ссылка на личный чат с поддержкой — перк тарифа «Магистр» (обычно
# https://t.me/<username> оператора). Пока не задана, тариф продаётся,
# но кнопка чата подписчику не показывается: лучше не показать перк,
# чем показать битую ссылку.
SUPPORT_CHAT_URL=

# DEV ONLY — set to true to let the paid features (spread interpretation,
# extra card) skip the subscription-quota check entirely. Leave
# false/unset everywhere else — this must never be true in production.
# See app/api/subscriptions.py.
SKIP_PAYMENT_CHECK=false
