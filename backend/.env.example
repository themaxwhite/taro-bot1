# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# Telegram bot token from @BotFather. Required for initData validation
# and for the /start "launch app" message.
TELEGRAM_BOT_TOKEN=

# SQLite by default — zero setup, one file. Point this at a Postgres URL
# in production (a managed one, e.g. Railway's Postgres add-on — SQLite
# has no persistent disk on most PaaS hosts, so its file gets wiped on
# every redeploy).
DATABASE_URL=sqlite:///./tarot.db

# API keys for the daily motivating message and the paid AI spread
# interpretation, tried in order: Gemini (free tier, no billing account
# needed — aistudio.google.com/apikey) -> Groq (also free, separate
# infra/quota from Google — console.groq.com/keys) -> Anthropic
# (pay-as-you-go, tried last). Each is only tried if the ones before it
# are unset or fail — e.g. Gemini's free tier has a low rate limit, so
# Groq covers you when it's hit. All features work with none configured
# (static fallback content), just less personalized.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ЮKassa (YooKassa) merchant credentials — shopId and secret key from
# your dashboard at yookassa.ru (requires a registered business; see
# DEPLOYMENT.md). Power the subscription paywall (spread interpretation,
# extra card). Subscriptions are unavailable with a clear error, not a
# crash, when either is unset.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Must match the secret passed to `setWebhook` (see DEPLOYMENT.md) so
# /api/telegram/webhook can reject requests that aren't actually from
# Telegram. Optional locally; required once the bot goes to production.
TELEGRAM_WEBHOOK_SECRET=

# Your deployed Mini App URL (Cloudflare Pages / Vercel domain). Used by
# the /start bot handler to send a "launch app" button as a backup to
# BotFather's chat menu button, and as the ЮKassa payment return_url.
MINI_APP_URL=

# DEV ONLY — set to true to let the paid features (spread interpretation,
# extra card) skip the subscription-quota check, so they can be tested
# without wiring up ЮKassa. Leave false/unset everywhere else — this
# must never be true in production. See app/api/subscriptions.py.
SKIP_PAYMENT_CHECK=false
