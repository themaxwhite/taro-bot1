# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# Telegram bot token from @BotFather. Required for initData validation
# AND for Stars payments (createInvoiceLink/webhook use it too).
TELEGRAM_BOT_TOKEN=

# SQLite by default — zero setup, one file. Point this at a Postgres URL
# in production if you need concurrent writers or a managed DB.
DATABASE_URL=sqlite:///./tarot.db

# Anthropic API key — powers the daily motivating message and the paid
# AI spread interpretation. Both features work without it (static
# fallback content), just less personalized.
ANTHROPIC_API_KEY=

# Prices in Telegram Stars for the two paid features.
PRICE_INTERPRETATION_STARS=50
PRICE_EXTRA_CARD_STARS=30

# Must match the secret passed to `setWebhook` (see DEPLOYMENT.md) so
# /api/telegram/webhook can reject requests that aren't actually from
# Telegram. Optional locally; required once payments go to production.
TELEGRAM_WEBHOOK_SECRET=
