# Base URL of the backend API (see ../backend). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# DEV ONLY — set to true to let "Подробное толкование" skip the Telegram
# Stars payment flow (which only works inside real Telegram) and call
# the interpretation endpoint directly. The backend must also have
# SKIP_PAYMENT_CHECK=true, or it'll still 402. Leave false/unset outside
# local testing. See src/pages/ResultScreen/ResultScreen.tsx.
VITE_SKIP_PAYMENT=false
